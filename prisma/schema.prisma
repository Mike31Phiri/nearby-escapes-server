generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// USER & HOST
// ─────────────────────────────────────────────

model User {
  id                     String             @id @default(uuid())
  name                   String
  email                  String             @unique
  password               String
  phone                  String?
  avatar                 String?
  role                   Role               @default(GUEST)
  isVerified             Boolean            @default(false)
  verificationStatus     VerificationStatus @default(PENDING)
  verificationCode       String?
  verificationCodeExpiry DateTime?
  resetToken             String?            @unique
  resetTokenExpiry       DateTime?
  refreshToken           String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  deletedAt              DateTime?
  activityLogs           ActivityLog[]
  bookingsAsGuest        Booking[]          @relation("GuestBookings")
  bookingsAsHost         Booking[]          @relation("HostBookings")
  hostApplication        HostApplication?
  hostProfile            HostProfile?
  notifications          Notification[]
  payments               Payment[]
  payouts                Payout[]
  createdPolicies        Policy[]           @relation("CreatedPolicies")
  createdPolicyVersions  PolicyVersion[]    @relation("CreatedPolicyVersions")
  properties             Property[]
  reviews                Review[]
  wishlist               Wishlist?
  raisedDisputes         Dispute[]          @relation("RaisedDisputes")
}

model HostProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  businessName        String?
  isApproved          Boolean  @default(false)
  defaultCheckInTime  String?  @default("14:00")
  defaultCheckOutTime String?  @default("10:00")
  payoutMethod        String?  @default("BANK_TRANSFER")
  payoutAccount       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Property {
  id              String                  @id @default(uuid())
  hostId          String
  type            PropertyType
  status          PropertyStatus          @default(ACTIVE)
  name            String
  description     String?                 @default("")
  location        String?                 @default("")
  currency        String                  @default("ZMW")
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  deletedAt       DateTime?
  draftData       Json?
  draftStep       Int?                    @default(1)
  bookings        Booking[]
  experiences     Experience[]
  recommendations ListingRecommendation[]
  tags            ListingTag[]
  host            User                    @relation(fields: [hostId], references: [id])
  amenities       PropertyAmenity[]
  images          PropertyImage[]
  rules           PropertyRule[]
  reviews         Review[]
  stays           Stay[]
  transports      Transport[]
  wishlistItems   WishlistItem[]

  @@index([status, deletedAt])
  @@index([type])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// STAYS
// ─────────────────────────────────────────────

/// Stay — the lodging section of a Property.
/// Stay — the lodging section of a Property.
/// unitType (Chalet, Villa, etc.) and rate (base price per night) belong here.
model Stay {
  id           String                  @id @default(uuid())
  propertyId   String
  name         String
  unitType     StayUnitType            @default(STANDARD_ROOM) // CHALET | APARTMENT | VILLA | COTTAGE | SUITE …
  rate         Int                     @default(0) // base price per night
  description  String?
  isActive     Boolean                 @default(true)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  deletedAt    DateTime?
   // Capacity inventory ledger (linked by stayId)
   inventory    StayInventory[]
   // Bookings
   stayBookings StayBooking[]
   // Images
   images       StayImage[]
   // Metadata & Policies (bedrooms, house rules, cancellation, etc.)
   policies        ListingPolicy[]
   recommendations ListingRecommendation[]
   tags            ListingTag[]
   property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, unitType])
}

/// Capacity ledger for a Stay unit.
/// `total` = how many units of this stay exist at the property.
/// `booked` + `available` = `total` — kept in sync by the service layer.
model StayInventory {
  id           String          @id @default(uuid())
  stayId       String
  total        Int             // total number of this unit type
  booked       Int             @default(0)
  available    Int             // total - booked; kept in sync
  status       InventoryStatus @default(AVAILABLE)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?
  stayBookings StayBooking[]
  stay         Stay            @relation(fields: [stayId], references: [id], onDelete: Cascade)

  @@index([stayId, status])
  @@index([stayId, available])
}

// ─────────────────────────────────────────────
// EXPERIENCES
// ─────────────────────────────────────────────

/// Experience — the experiences section of a Property.
/// experienceType (Cultural, Adventure, etc.) and rate (base price per participant) belong here.
model Experience {
  id                   String                  @id @default(uuid())
  propertyId           String
  name                 String
  experienceType       ExperienceType          @default(ADVENTURE) // ENTERTAINMENT | CULTURAL | ADVENTURE | NATURE …
  rate                 Int                     @default(0) // price per participant
  description          String?
  meetingPoint         String?
  meetingPointAddress  String?
  whatsNotIncluded     String[]                @default([])
  whatToBring          String[]                @default([])
  whatNotToBring       String[]                @default([])
  importantInformation String[]                @default([])
  notSuitableFor       String[]                @default([])
  isActive             Boolean                 @default(true)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  deletedAt            DateTime?
   // First-class time slots (e.g. 10-13hrs, 15-17hrs)
   slots                ExperienceSlot[]
   // Bookings (via time slots)
   experienceBookings   ExperienceBooking[]
   // Images
   images               ExperienceImage[]
   // Metadata
   inclusions           ExperienceInclusion[]
   policies             ListingPolicy[]
   recommendations      ListingRecommendation[]
   tags                 ListingTag[]
   property             Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, experienceType])
}

/// First-class time slot for an Experience (e.g. 10-13hrs slot, 15-17hrs slot).
/// `maxCapacity` = max participants allowed in this specific time window.
/// `booked` + `available` = `maxCapacity` — kept in sync by the service layer.
model ExperienceSlot {
  id                 String              @id @default(uuid())
  experienceId       String
  startTime          String              // e.g. "10:00"
  endTime            String              // e.g. "13:00"
  label              String?             // e.g. "Morning Session (10:00 - 13:00)"
  maxCapacity        Int                 // spots per slot (e.g. 12)
  booked             Int                 @default(0)
  available          Int                 // maxCapacity - booked; kept in sync
  status             InventoryStatus     @default(AVAILABLE)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  experienceBookings ExperienceBooking[]
  experience         Experience          @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId, status])
  @@index([experienceId, available])
}

// ─────────────────────────────────────────────
// TRANSPORT
// ─────────────────────────────────────────────

/// Transport — the transport section of a Property.
/// routeType, tripType, and rate belong here.
model Transport {
  id                String                  @id @default(uuid())
  propertyId        String
  name              String
  rentalType        String?                 // e.g. "seat_based", "private_hire", "charter" (from API payload)
  routeType         String?                 // e.g. "inter_city", "local", "airport_transfer" (from API payload)
  tripType          TripType                @default(ONE_WAY) // ONE_WAY | ROUND_TRIP
  rate              Int                     @default(0) // base rate (per seat or whole vehicle)
  vehicleType       String?                 // e.g. "bus", "minivan", "sedan", "suv", "boat" (from API payload)
  description       String?
  from              String?                 // departure point
  to                String?                 // destination
  returnFrom        String?                 // for ROUND_TRIP: return departure point
  returnTo          String?                 // for ROUND_TRIP: return destination
  departureTime     String?                 // e.g. "07:00"
  returnTime        String?                 // for ROUND_TRIP: e.g. "17:00"
  isActive          Boolean                 @default(true)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  deletedAt         DateTime?
   // Capacity ledger (linked by transportId)
   inventory         TransportInventory[]
   // Bookings
   transportBookings TransportBooking[]
   // Images
   images            TransportImage[]
   // Metadata
   policies          ListingPolicy[]
   recommendations   ListingRecommendation[]
   tags              ListingTag[]
   property          Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, tripType])
}

/// Capacity ledger for a Transport route/service.
/// For SEAT_BASED: totalSeats = total seats on the vehicle (e.g. 50 on a bus).
/// For PRIVATE_HIRE: totalSeats = number of vehicles available (e.g. 1 or fleet count).
/// `booked` + `available` = `totalSeats` — kept in sync by the service layer.
model TransportInventory {
  id             String              @id @default(uuid())
  transportId    String
  totalSeats     Int                 // seat capacity (or vehicle count if PRIVATE_HIRE)
  booked         Int                 @default(0)
  available      Int                 // totalSeats - booked; kept in sync
  status         InventoryStatus     @default(AVAILABLE)
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deletedAt      DateTime?
  transportBookings TransportBooking[]
  transport      Transport           @relation(fields: [transportId], references: [id], onDelete: Cascade)

  @@index([transportId, status])
  @@index([transportId, available])
}

model PropertyImage {
  id         String   @id @default(uuid())
  propertyId String
  url        String
  sortOrder  Int      @default(0)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, sortOrder])
}

model StayImage {
  id      String @id @default(uuid())
  stayId  String
  url     String
  altText String?
  sortOrder Int  @default(0)
  stay    Stay   @relation(fields: [stayId], references: [id], onDelete: Cascade)

  @@index([stayId, sortOrder])
}

model ExperienceImage {
  id            String     @id @default(uuid())
  experienceId  String
  url           String
  altText       String?
  sortOrder     Int        @default(0)
  experience    Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId, sortOrder])
}

model TransportImage {
  id          String    @id @default(uuid())
  transportId String
  url         String
  altText     String?
  sortOrder   Int       @default(0)
  transport   Transport @relation(fields: [transportId], references: [id], onDelete: Cascade)

  @@index([transportId, sortOrder])
}

model PropertyAmenity {
  id         String   @id @default(uuid())
  propertyId String
  name       String
  icon       String?
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, name])
  @@index([propertyId])
}

model PropertyRule {
  id         String   @id @default(uuid())
  propertyId String
  rule       String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}


model ExperienceInclusion {
  id           String     @id @default(uuid())
  experienceId String
  item         String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId])
}

// ─────────────────────────────────────────────
// BOOKINGS  (header + type-specific detail)
// ─────────────────────────────────────────────

/// Booking header — one row per booking regardless of type.
/// Payments, cancellations, and guest history all query this table.
model Booking {
  id              String        @id @default(uuid())
  bookingRef      String        @unique
  propertyId      String
  guestId         String
  hostId          String
  type            BookingType   @default(STAY) // STAY | EXPERIENCE | TRANSPORT
  status          BookingStatus @default(PENDING)
  amount          Int
  currency        String        @default("ZMW")
  paymentStatus   PaymentStatus @default(UNPAID)
  transToken      String?
  customerName    String
  customerPhone   String
  customerEmail   String?
  specialRequests String?
  refundAmount    Int?          @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  expiresAt       DateTime?
  // Type-specific detail (exactly one will be set)
  stayBooking       StayBooking?
  experienceBooking ExperienceBooking?
  transportBooking  TransportBooking?
  // Relations
  guest     User      @relation("GuestBookings", fields: [guestId], references: [id])
  host      User      @relation("HostBookings", fields: [hostId], references: [id])
  property  Property  @relation(fields: [propertyId], references: [id])
  payment   Payment?
  payout    Payout?
  disputes  Dispute[]

  @@index([guestId, status, createdAt])
  @@index([hostId, status, createdAt])
  @@index([propertyId, type, status])
  @@index([type, status])
}

/// Stay-specific booking detail.
/// Links to the exact unit type (StayInventory) booked, e.g. the Chalet or Apartment.
model StayBooking {
  id               String        @id @default(uuid())
  bookingId        String        @unique
  stayId           String        // parent Stay listing
  stayInventoryId  String        // specific unit type booked (Chalet, Apartment, etc.)
  checkIn          DateTime
  checkOut         DateTime
  guests           Int           @default(1)
  checkedInAt      DateTime?
  checkedOutAt     DateTime?
  booking          Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  stay             Stay          @relation(fields: [stayId], references: [id])
  stayInventory    StayInventory @relation(fields: [stayInventoryId], references: [id])

  @@index([stayId, checkIn, checkOut])
  @@index([stayInventoryId, checkIn, checkOut])
}

/// Experience-specific booking detail.
/// Links to the exact time slot (ExperienceSlot, e.g. 10-13hrs) booked.
model ExperienceBooking {
  id               String         @id @default(uuid())
  bookingId        String         @unique
  experienceId     String         // parent Experience listing
  experienceSlotId String         // specific time slot booked (10-13hrs, 15-17hrs)
  date             DateTime
  guests           Int            @default(1)
  booking          Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  experience       Experience     @relation(fields: [experienceId], references: [id])
  experienceSlot   ExperienceSlot @relation(fields: [experienceSlotId], references: [id])

  @@index([experienceId, date])
  @@index([experienceSlotId, date])
}

/// Transport-specific booking detail.
/// Links to the exact service type (TransportInventory) booked (route + trip type).
model TransportBooking {
  id                   String             @id @default(uuid())
  bookingId            String             @unique
  transportId          String             // parent Transport listing
  transportInventoryId String             // specific inventory ledger booked
  date                 DateTime
  seats                Int                @default(1)   // seats booked (or 1 if PRIVATE_HIRE)
  booking              Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  transport            Transport          @relation(fields: [transportId], references: [id])
  transportInventory   TransportInventory @relation(fields: [transportInventoryId], references: [id])

  @@index([transportId, date])
  @@index([transportInventoryId, date])
}

model Payment {
  id               String        @id @default(uuid())
  bookingId        String        @unique
  userId           String
  amount           Int
  commissionAmount Int?
  hostAmount       Int?
  status           PaymentStatus @default(UNPAID)
  provider         String?
  providerRef      String?
  receiptUrl       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  booking          Booking       @relation(fields: [bookingId], references: [id])
  user             User          @relation(fields: [userId], references: [id])
}

model Payout {
  id          String       @id @default(uuid())
  hostId      String
  amount      Int
  commission  Int?
  netAmount   Int?
  period      String?
  status      PayoutStatus @default(PENDING)
  method      String?
  bookingRefs String[]
  processedAt DateTime?
  createdAt   DateTime     @default(now())
  bookingId   String?      @unique
  booking     Booking?     @relation(fields: [bookingId], references: [id])
  host        User         @relation(fields: [hostId], references: [id])
}

model Review {
  id         String   @id @default(uuid())
  propertyId String
  bookingRef String?
  guestId    String
  rating     Int
  text       String?
  createdAt  DateTime @default(now())
  guest      User     @relation(fields: [guestId], references: [id])
  property   Property @relation(fields: [propertyId], references: [id])

  @@unique([propertyId, guestId, bookingRef])
}

model Notification {
  id          String           @id @default(uuid())
  userId      String
  type        NotificationType
  title       String
  description String
  isRead      Boolean          @default(false)
  actionUrl   String?
  createdAt   DateTime         @default(now())
  actionLabel String?
  deletedAt   DateTime?
  metadata    Json?
  user        User             @relation(fields: [userId], references: [id])
}

model Wishlist {
  id        String         @id @default(uuid())
  userId    String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id])
  items     WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  propertyId String
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, propertyId])
  @@index([propertyId])
  @@index([wishlistId, createdAt])
}

// AvailabilitySlot removed — replaced by StayInventory (see Stay section)

model ActivityLog {
  id        String   @id @default(uuid())
  action    String
  userId    String?
  userRole  String?
  target    String?
  type      String
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model Dispute {
  id           String          @id @default(uuid())
  bookingId    String
  bookingRef   String
  propertyName String
  propertyType String
  guestId      String
  guestName    String
  hostId       String
  hostName     String
  amount       Int
  reason       String
  description  String?
  status       DisputeStatus   @default(OPEN)
  priority     DisputePriority @default(MEDIUM)
  raisedBy     String
  raisedById   String
  raisedAt     DateTime        @default(now())
  resolvedAt   DateTime?
  resolution   String?
  booking      Booking         @relation(fields: [bookingId], references: [id])
  raisedByUser User            @relation("RaisedDisputes", fields: [raisedById], references: [id])

  @@index([status])
  @@index([guestId])
  @@index([hostId])
  @@index([bookingId])
}

model Setting {
  id          String   @id @default(uuid())
  category    String
  key         String   @unique
  label       String
  value       String
  type        String
  options     String[]
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ListingPolicy {
  id           String                @id @default(uuid())
  stayId       String?
  experienceId String?
  transportId  String?
  category     ListingPolicyCategory @default(OTHER)
  title        String
  body         String
  sortOrder    Int                   @default(0)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  experience   Experience?           @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  stay         Stay?                 @relation(fields: [stayId], references: [id], onDelete: Cascade)
  transport    Transport?            @relation(fields: [transportId], references: [id], onDelete: Cascade)

  @@index([stayId])
  @@index([experienceId])
  @@index([transportId])
}

model ListingTag {
  id           String      @id @default(uuid())
  propertyId   String?
  stayId       String?
  experienceId String?
  transportId  String?
  category     TagCategory @default(CATEGORY)
  name         String
  slug         String
  icon         String?
  createdAt    DateTime    @default(now())
  experience   Experience? @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  property     Property?   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  stay         Stay?       @relation(fields: [stayId], references: [id], onDelete: Cascade)
  transport    Transport?  @relation(fields: [transportId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([stayId])
  @@index([experienceId])
  @@index([transportId])
  @@index([category, slug])
}

model ListingRecommendation {
  id           String                 @id @default(uuid())
  propertyId   String?
  stayId       String?
  experienceId String?
  transportId  String?
  audience     RecommendationAudience @default(GENERAL)
  title        String
  reason       String?
  badge        String?
  sortOrder    Int                    @default(0)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  experience   Experience?            @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  property     Property?              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  stay         Stay?                  @relation(fields: [stayId], references: [id], onDelete: Cascade)
  transport    Transport?             @relation(fields: [transportId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([stayId])
  @@index([experienceId])
  @@index([transportId])
  @@index([audience])
}

model Policy {
  id             String          @id @default(uuid())
  slug           String          @unique
  title          String
  type           PolicyType      @default(OTHER)
  description    String?
  isPublished    Boolean         @default(false)
  currentVersion String          @default("1.0.0")
  createdById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  createdBy      User?           @relation("CreatedPolicies", fields: [createdById], references: [id])
  versions       PolicyVersion[]

  @@index([slug])
  @@index([type])
  @@index([isPublished])
}

model PolicyVersion {
  id            String   @id @default(uuid())
  policyId      String
  version       String
  content       String
  summary       String?
  documentUrl   String?
  metadata      Json?
  effectiveDate DateTime @default(now())
  createdById   String?
  createdAt     DateTime @default(now())
  createdBy     User?    @relation("CreatedPolicyVersions", fields: [createdById], references: [id])
  policy        Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, version])
  @@index([policyId])
}

model MediaAsset {
  id        String   @id @default(uuid())
  url       String   @unique
  category  String?  @default("GENERAL")
  caption   String?
  source    String?  @default("UNSPLASH")
  createdAt DateTime @default(now())

  @@index([category])
}

model HostApplication {
  id             String    @id @default(uuid())
  userId         String    @unique
  businessName   String
  operatingSince String?
  province       String?
  town           String?
  businessEmail  String?
  businessPhone  String?
  pacraDocs      Json?
  ownershipDocs  Json?
  operationDocs  Json?
  status         String    @default("pending_review")
  reviewerNotes  String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
}

enum Role {
  GUEST
  HOST
  ADMIN
  SUPER_ADMIN
}

enum PropertyType {
  STAY
  EXPERIENCE
  TRANSPORT
}

enum PropertyStatus {
  DRAFT
  PENDING
  ACTIVE
  BOOKED
  INACTIVE
}

enum BookingType {
  STAY
  EXPERIENCE
  TRANSPORT
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  EXPIRED
  CHECKED_IN
}

enum InventoryStatus {
  AVAILABLE
  FULLY_BOOKED
  BLOCKED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum CancellationPolicy {
  FLEXIBLE
  MODERATE
  STRICT
}

enum VerificationStatus {
  PENDING
  VERIFIED
  SUSPENDED
}

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_REQUEST
  CHECKED_IN
  CHECKED_OUT
  REVIEW_RECEIVED
  SYSTEM
  PROPERTY_APPROVED
  PROPERTY_REJECTED
  PAYOUT
  LISTING_APPROVED
  LISTING_REJECTED
  MESSAGE
  PROMOTION
}

enum DisputeStatus {
  OPEN
  INVESTIGATING
  RESOLVED_HOST
  RESOLVED_GUEST
  REFUNDED
  CLOSED
}

enum DisputePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
