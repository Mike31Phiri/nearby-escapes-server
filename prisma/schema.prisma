generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String             @id @default(uuid())
  name                  String
  email                 String             @unique
  password              String
  phone                 String?
  avatar                String?
  role                  Role               @default(GUEST)
  isVerified            Boolean            @default(false)
  verificationStatus    VerificationStatus @default(PENDING)
  verificationCode      String?
  verificationCodeExpiry DateTime?
  resetToken            String?            @unique
  resetTokenExpiry      DateTime?
  refreshToken          String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  deletedAt             DateTime?
  activityLogs          ActivityLog[]
  bookingsAsGuest       Booking[]          @relation("GuestBookings")
  bookingsAsHost        Booking[]          @relation("HostBookings")
  hostApplication       HostApplication?
  hostProfile           HostProfile?
  notifications         Notification[]
  payments              Payment[]
  payouts               Payout[]
  createdPolicies       Policy[]           @relation("CreatedPolicies")
  createdPolicyVersions PolicyVersion[]    @relation("CreatedPolicyVersions")
  properties            Property[]
  reviews               Review[]
  wishlist              Wishlist?
}

model HostProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  businessName        String?
  isApproved          Boolean  @default(false)
  defaultCheckInTime  String?  @default("14:00")
  defaultCheckOutTime String?  @default("10:00")
  payoutMethod        String?  @default("BANK_TRANSFER")
  payoutAccount       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Property {
  id              String                  @id @default(uuid())
  hostId          String
  type            PropertyType
  status          PropertyStatus          @default(ACTIVE)
  name            String
  description     String?                 @default("")
  location        String?                 @default("")
  currency        String                  @default("ZMW")
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  deletedAt       DateTime?
  draftData       Json?
  draftStep       Int?                    @default(1)
  bookings        Booking[]
  experiences     Experience[]
  recommendations ListingRecommendation[]
  tags            ListingTag[]
  host            User                    @relation(fields: [hostId], references: [id])
  amenities       PropertyAmenity[]
  images          PropertyImage[]
  rules           PropertyRule[]
  reviews         Review[]
  stays           Stay[]
  transports      Transport[]
  wishlistItems   WishlistItem[]

  @@index([status, deletedAt])
  @@index([type])
  @@index([createdAt])
}

model Stay {
  id                 String                  @id @default(uuid())
  propertyId         String
  name               String
  description        String?
  price              Int
  roomType           String?
  bedrooms           Int?
  beds               Int?
  baths              Int?
  maxGuests          Int?
  checkInFrom        String?
  checkInUntil       String?
  checkOutBefore     String?
  cancellationPolicy CancellationPolicy?
  isActive           Boolean                 @default(true)
  sortOrder          Int                     @default(0)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  deletedAt          DateTime?
  availability       AvailabilitySlot[]
  bookings           Booking[]               @relation("StayBookings")
  policies           ListingPolicy[]
  recommendations    ListingRecommendation[]
  tags               ListingTag[]
  seasonalPrices     SeasonalPricing[]
  property           Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Experience {
  id              String                  @id @default(uuid())
  propertyId      String
  name            String
  description     String?
  price           Int
  activityType    String?
  duration        String?
  maxParticipants Int?
  difficultyLevel String?
  meetingPoint    String?
  isActive        Boolean                 @default(true)
  sortOrder       Int                     @default(0)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  deletedAt       DateTime?
  bookings        Booking[]               @relation("ExperienceBookings")
  property        Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  inclusions      ExperienceInclusion[]
  timeSlots       ExperienceTimeSlot[]
  policies        ListingPolicy[]
  recommendations ListingRecommendation[]
  tags            ListingTag[]
}

model Transport {
  id              String                  @id @default(uuid())
  propertyId      String
  name            String
  description     String?
  from            String?
  to              String?
  vehicleType     String?
  capacity        Int?
  pricePerSeat    Int?
  schedule        Json?
  isActive        Boolean                 @default(true)
  sortOrder       Int                     @default(0)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  deletedAt       DateTime?
  bookings        Booking[]               @relation("TransportBookings")
  policies        ListingPolicy[]
  recommendations ListingRecommendation[]
  tags            ListingTag[]
  property        Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model PropertyImage {
  id         String   @id @default(uuid())
  propertyId String
  url        String
  sortOrder  Int      @default(0)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, sortOrder])
}

model PropertyAmenity {
  id         String   @id @default(uuid())
  propertyId String
  name       String
  icon       String?
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, name])
  @@index([propertyId])
}

model PropertyRule {
  id         String   @id @default(uuid())
  propertyId String
  rule       String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model ExperienceTimeSlot {
  id           String     @id @default(uuid())
  experienceId String
  slot         String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId])
}

model ExperienceInclusion {
  id           String     @id @default(uuid())
  experienceId String
  item         String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId])
}

model Booking {
  id              String        @id @default(uuid())
  bookingRef      String        @unique
  propertyId      String
  stayId          String?
  experienceId    String?
  transportId     String?
  guestId         String
  hostId          String
  status          BookingStatus @default(PENDING)
  amount          Int
  currency        String        @default("ZMW")
  paymentStatus   PaymentStatus @default(UNPAID)
  transToken      String?
  customerName    String
  customerPhone   String
  customerEmail   String?
  specialRequests String?
  checkIn         DateTime?
  checkOut        DateTime?
  date            DateTime?
  guests          Int           @default(1)
  refundAmount    Int?          @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  expiresAt       DateTime?
  timeSlot        String?
  checkedInAt     DateTime?
  checkedOutAt    DateTime?
  experience      Experience?   @relation("ExperienceBookings", fields: [experienceId], references: [id])
  guest           User          @relation("GuestBookings", fields: [guestId], references: [id])
  host            User          @relation("HostBookings", fields: [hostId], references: [id])
  property        Property      @relation(fields: [propertyId], references: [id])
  stay            Stay?         @relation("StayBookings", fields: [stayId], references: [id])
  transport       Transport?    @relation("TransportBookings", fields: [transportId], references: [id])
  payment         Payment?
  payout          Payout?

  @@index([stayId, status, checkIn, checkOut])
  @@index([experienceId, status, date, timeSlot])
  @@index([transportId, status, date])
}

model Payment {
  id               String        @id @default(uuid())
  bookingId        String        @unique
  userId           String
  amount           Int
  commissionAmount Int?
  hostAmount       Int?
  status           PaymentStatus @default(UNPAID)
  provider         String?
  providerRef      String?
  receiptUrl       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  booking          Booking       @relation(fields: [bookingId], references: [id])
  user             User          @relation(fields: [userId], references: [id])
}

model Payout {
  id          String       @id @default(uuid())
  hostId      String
  amount      Int
  commission  Int?
  netAmount   Int?
  period      String?
  status      PayoutStatus @default(PENDING)
  method      String?
  bookingRefs String[]
  processedAt DateTime?
  createdAt   DateTime     @default(now())
  bookingId   String?      @unique
  booking     Booking?     @relation(fields: [bookingId], references: [id])
  host        User         @relation(fields: [hostId], references: [id])
}

model Review {
  id         String   @id @default(uuid())
  propertyId String
  bookingRef String?
  guestId    String
  rating     Int
  text       String?
  createdAt  DateTime @default(now())
  guest      User     @relation(fields: [guestId], references: [id])
  property   Property @relation(fields: [propertyId], references: [id])

  @@unique([propertyId, guestId, bookingRef])
}

model Notification {
  id          String           @id @default(uuid())
  userId      String
  type        NotificationType
  title       String
  description String
  isRead      Boolean          @default(false)
  actionUrl   String?
  createdAt   DateTime         @default(now())
  actionLabel String?
  deletedAt   DateTime?
  metadata    Json?
  user        User             @relation(fields: [userId], references: [id])
}

model Wishlist {
  id        String         @id @default(uuid())
  userId    String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id])
  items     WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  propertyId String
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, propertyId])
  @@index([propertyId])
  @@index([wishlistId, createdAt])
}

model AvailabilitySlot {
  id     String   @id @default(uuid())
  stayId String
  date   DateTime
  status String   @default("available")
  price  Int?
  stay   Stay     @relation(fields: [stayId], references: [id])

  @@unique([stayId, date])
}

model SeasonalPricing {
  id     String   @id @default(uuid())
  stayId String
  from   DateTime
  to     DateTime
  price  Int      @default(0)
  label  String?
  stay   Stay     @relation(fields: [stayId], references: [id])
}

model ActivityLog {
  id        String   @id @default(uuid())
  action    String
  userId    String?
  userRole  String?
  target    String?
  type      String
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model Dispute {
  id           String          @id @default(uuid())
  bookingRef   String
  propertyName String
  propertyType String
  guestId      String
  guestName    String
  hostId       String
  hostName     String
  amount       Int
  reason       String
  description  String?
  status       DisputeStatus   @default(OPEN)
  priority     DisputePriority @default(MEDIUM)
  raisedBy     String
  raisedAt     DateTime        @default(now())
  resolvedAt   DateTime?
  resolution   String?
}

model Setting {
  id          String   @id @default(uuid())
  category    String
  key         String   @unique
  label       String
  value       String
  type        String
  options     String[]
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ListingPolicy {
  id           String                @id @default(uuid())
  stayId       String?
  experienceId String?
  transportId  String?
  category     ListingPolicyCategory @default(OTHER)
  title        String
  body         String
  sortOrder    Int                   @default(0)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  experience   Experience?           @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  stay         Stay?                 @relation(fields: [stayId], references: [id], onDelete: Cascade)
  transport    Transport?            @relation(fields: [transportId], references: [id], onDelete: Cascade)

  @@index([stayId])
  @@index([experienceId])
  @@index([transportId])
}

model ListingTag {
  id           String      @id @default(uuid())
  propertyId   String?
  stayId       String?
  experienceId String?
  transportId  String?
  category     TagCategory @default(CATEGORY)
  name         String
  slug         String
  icon         String?
  createdAt    DateTime    @default(now())
  experience   Experience? @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  property     Property?   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  stay         Stay?       @relation(fields: [stayId], references: [id], onDelete: Cascade)
  transport    Transport?  @relation(fields: [transportId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([stayId])
  @@index([experienceId])
  @@index([transportId])
  @@index([category, slug])
}

model ListingRecommendation {
  id           String                 @id @default(uuid())
  propertyId   String?
  stayId       String?
  experienceId String?
  transportId  String?
  audience     RecommendationAudience @default(GENERAL)
  title        String
  reason       String?
  badge        String?
  sortOrder    Int                    @default(0)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  experience   Experience?            @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  property     Property?              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  stay         Stay?                  @relation(fields: [stayId], references: [id], onDelete: Cascade)
  transport    Transport?             @relation(fields: [transportId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([stayId])
  @@index([experienceId])
  @@index([transportId])
  @@index([audience])
}

model Policy {
  id             String          @id @default(uuid())
  slug           String          @unique
  title          String
  type           PolicyType      @default(OTHER)
  description    String?
  isPublished    Boolean         @default(false)
  currentVersion String          @default("1.0.0")
  createdById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  createdBy      User?           @relation("CreatedPolicies", fields: [createdById], references: [id])
  versions       PolicyVersion[]

  @@index([slug])
  @@index([type])
  @@index([isPublished])
}

model PolicyVersion {
  id            String   @id @default(uuid())
  policyId      String
  version       String
  content       String
  summary       String?
  documentUrl   String?
  metadata      Json?
  effectiveDate DateTime @default(now())
  createdById   String?
  createdAt     DateTime @default(now())
  createdBy     User?    @relation("CreatedPolicyVersions", fields: [createdById], references: [id])
  policy        Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, version])
  @@index([policyId])
}

model MediaAsset {
  id        String   @id @default(uuid())
  url       String   @unique
  category  String?  @default("GENERAL")
  caption   String?
  source    String?  @default("UNSPLASH")
  createdAt DateTime @default(now())

  @@index([category])
}

model HostApplication {
  id             String    @id @default(uuid())
  userId         String    @unique
  businessName   String
  operatingSince String?
  province       String?
  town           String?
  businessEmail  String?
  businessPhone  String?
  pacraDocs      Json?
  ownershipDocs  Json?
  operationDocs  Json?
  status         String    @default("pending_review")
  reviewerNotes  String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
}

enum Role {
  GUEST
  HOST
  ADMIN
}

enum PropertyType {
  STAY
  EXPERIENCE
  TRANSPORT
}

enum PropertyStatus {
  DRAFT
  PENDING
  ACTIVE
  INACTIVE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  EXPIRED
  CHECKED_IN
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum CancellationPolicy {
  FLEXIBLE
  MODERATE
  STRICT
}

enum VerificationStatus {
  PENDING
  VERIFIED
  SUSPENDED
}

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_REQUEST
  CHECKED_IN
  CHECKED_OUT
  REVIEW_RECEIVED
  SYSTEM
  PROPERTY_APPROVED
  PROPERTY_REJECTED
  PAYOUT
  LISTING_APPROVED
  LISTING_REJECTED
  MESSAGE
  PROMOTION
}

enum DisputeStatus {
  OPEN
  INVESTIGATING
  RESOLVED_HOST
  RESOLVED_GUEST
  REFUNDED
  CLOSED
}

enum DisputePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum PolicyType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  CANCELLATION
  REFUND_POLICY
  HOST_STANDARDS
  GUEST_STANDARDS
  TRUST_SAFETY
  OTHER
}

enum ListingPolicyCategory {
  CANCELLATION
  CHECK_IN
  CHECK_OUT
  HOUSE_RULES
  SAFETY
  PET_POLICY
  CHILD_POLICY
  NOISE_POLICY
  SMOKING_POLICY
  REFUND
  DAMAGE
  OTHER
}

enum TagCategory {
  CATEGORY
  AMENITY
  ACTIVITY
  LOCATION
  TRIP_TYPE
  VEHICLE_TYPE
  OTHER
}

enum RecommendationAudience {
  COUPLES
  FAMILIES
  SOLO
  ADVENTURE
  NATURE
  WEEKEND_GETAWAY
  BUDGET
  LUXURY
  GENERAL
}
